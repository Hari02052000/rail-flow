NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://railflow:railflow_dev_password@localhost:5432/railflow_users
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Separate database used by repository integration tests.
TEST_DATABASE_URL=postgresql://railflow:railflow_dev_password@localhost:5432/railflow_users_test

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=railflow:user-service:

OTP_HMAC_SECRET=development-only-change-this-otp-secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@railflow.local
